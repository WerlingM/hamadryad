# Copy to .env and fill in values before running.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the yardscape PostgreSQL user.
DB_PASSWORD=changeme

# Full PostgreSQL connection string used by Prisma and the API.
# In Docker Compose the hostname is "db". In local dev use localhost:5432.
DATABASE_URL=postgresql://yardscape:changeme@localhost:5432/yardscape

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret for signing short-lived access tokens (15 min).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex

# Secret for signing long-lived refresh tokens (30 days). Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex

# Token lifetimes (jsonwebtoken expiresIn format).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001

# Allowed CORS origin in production. In dev, Vite proxies /graphql so CORS is moot.
CORS_ORIGIN=http://localhost:3000

# ── Registration guard ────────────────────────────────────────────────────────
# Set to "true" to enable the register mutation.
# Keep "false" in production; use `pnpm seed` to create users instead.
ALLOW_REGISTRATION=true

# ── Seed ──────────────────────────────────────────────────────────────────────
# Credentials for the admin user created by `pnpm seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme_admin
SEED_ADMIN_DISPLAY_NAME=Admin
