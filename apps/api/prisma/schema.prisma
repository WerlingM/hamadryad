generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator pothos {
  provider          = "prisma-pothos-types"
  generateDatamodel = "true"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedHomes  Home[]
  memberships HomeMember[]

  @@map("users")
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum YardLocation {
  FRONT
  BACK
  SIDE_LEFT
  SIDE_RIGHT
  OTHER
}

model Home {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  address       String
  notes         String?
  /// Normalized parcel boundary (MultiPolygon GeoJSON geometry) for rendering.
  parcelGeoJson  Json?
  /// Same boundary as PostGIS geometry for spatial queries. Read/written with raw SQL.
  parcelGeometry Unsupported("geometry(MultiPolygon, 4326)")?
  ownerId       String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner   User         @relation(fields: [ownerId], references: [id])
  members HomeMember[]
  yards   Yard[]

  @@index([ownerId])
  @@index([parcelGeometry], type: Gist)
  @@map("homes")
}

model HomeMember {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  homeId String     @db.Uuid
  userId String     @db.Uuid
  role   MemberRole

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId])
  @@index([userId])
  @@map("home_members")
}

model Yard {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  homeId      String       @db.Uuid
  name        String
  location    YardLocation
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  home Home  @relation(fields: [homeId], references: [id], onDelete: Cascade)
  beds Bed[]

  @@index([homeId])
  @@map("yards")
}

enum Sunlight {
  FULL_SUN
  PART_SHADE
  FULL_SHADE
}

enum Moisture {
  DRY
  AVERAGE
  MOIST
  WET
}

model Bed {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  yardId      String   @db.Uuid
  name        String
  description String?
  sunlight    Sunlight
  moisture    Moisture
  /// Bed outline. Read/written with raw SQL (ST_AsGeoJSON / ST_GeomFromGeoJSON).
  geometry    Unsupported("geometry(Polygon, 4326)")?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  yard Yard @relation(fields: [yardId], references: [id], onDelete: Cascade)

  @@index([yardId])
  @@index([geometry], type: Gist)
  @@map("beds")
}
